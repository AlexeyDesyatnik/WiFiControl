<Window x:Class="WiFiControl.Recon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="WiFiControl — разведка" Width="900" Height="700" MinWidth="500" MinHeight="300">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="ReadAgainButton" Content="Прочитать заново" Click="OnReadAgain" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Сохранить отчёт" Click="OnSave" Style="{DynamicResource AccentButtonStyle}" />
            <TextBlock x:Name="Status" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Прочитанное: по блоку на каждое чтение, новые снизу -->
        <ScrollViewer x:Name="ReadingsScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ReadingsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="12" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
