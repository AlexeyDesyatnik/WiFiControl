<Window x:Class="WiFiControl.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="520" Height="640" MinWidth="410" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=ProfileName}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" IsDefault="True" Click="OnSave" MinWidth="110"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Label Content="Название профиля" Target="{Binding ElementName=ProfileName}" Padding="0,0,0,4" />
                <TextBox x:Name="ProfileName" />

                <GroupBox Header="Настройки IPv4" Margin="0,12,0,0" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="AutoAddress" Content="Получать адрес автоматически"
                                  Checked="OnAddressModeChanged" Unchecked="OnAddressModeChanged" />
                        <Grid x:Name="AddressFields" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="Адрес IPv4" Target="{Binding ElementName=Address}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="1" x:Name="Address" Margin="0,0,0,4" />
                            <Label Grid.Row="1" Content="Маска" Target="{Binding ElementName=Mask}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="Mask" Margin="0,0,0,4" />
                            <Label Grid.Row="2" Content="Шлюз" Target="{Binding ElementName=Gateway}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="Gateway" />
                        </Grid>
                        <CheckBox x:Name="AutoDns" Content="Получать DNS автоматически" Margin="0,8,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="DNS-сервер" Target="{Binding ElementName=Dns1}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Column="1" x:Name="Dns1" Margin="0,0,0,4" />
                            <Label Grid.Row="1" Content="Второй DNS-сервер" Target="{Binding ElementName=Dns2}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="Dns2" />
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=AutoDns}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Настройки прокси" Margin="0,12,0,0" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="ProxyEnabled" Content="Использовать прокси" />
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=ProxyEnabled}">
                            <Label Content="Прокси-сервер (адрес:порт)" Target="{Binding ElementName=ProxyServer}" Padding="0,6,0,4" />
                            <TextBox x:Name="ProxyServer" />
                            <Label Content="Исключения (по одному на строку)" Target="{Binding ElementName=ProxyExceptions}" Padding="0,6,0,4" />
                            <TextBox x:Name="ProxyExceptions" AcceptsReturn="True" MinLines="2" MaxLines="4"
                                     VerticalScrollBarVisibility="Auto" />
                            <CheckBox x:Name="BypassLocal" Content="Не использовать прокси для локальных адресов" Margin="0,8,0,0" />
                            <CheckBox x:Name="PrivateNetworksDirect" Content="Не через прокси для частных сетей" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
