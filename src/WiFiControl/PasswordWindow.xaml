<Window x:Class="WiFiControl.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=Password}">
    <StackPanel Margin="16,14,16,16">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />

        <StackPanel x:Name="PasswordPanel" Margin="0,12,0,0">
            <TextBlock Text="Пароль" FontSize="12.5" Margin="0,0,0,4" />
            <PasswordBox x:Name="Password" PasswordChanged="OnPasswordChanged" />
            <TextBlock x:Name="Hint" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Name="OpenNote" Text="Сеть открытая: пароль не нужен, данные передаются без шифрования." FontSize="12.5"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <!-- Режим автоподключения живёт в профиле сети Windows; по умолчанию — как в Windows -->
        <CheckBox x:Name="AutoConnect" Content="Подключаться автоматически" IsChecked="True" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="Connect" Content="Подключиться" IsDefault="True" Click="OnConnectClick" MinWidth="110"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
