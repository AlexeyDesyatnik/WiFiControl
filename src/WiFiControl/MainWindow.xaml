<Window x:Class="WiFiControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WiFiControl"
        x:ClassModifier="internal"
        Title="WiFiControl" Width="440" Height="760" MinWidth="360" MinHeight="400">
    <!-- Раскладка A2 из прототипа #31 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12,10,12,12">
        <!-- Строка инструментов -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" ToolTip="Обновить" Padding="8,6">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="14" />
            </Button>
            <TextBlock Text="{Binding AdapterName}" Style="{StaticResource Secondary}" ToolTip="Wi-Fi-адаптер" />
        </DockPanel>

        <!-- Карточка «Сейчас» -->
        <Border DockPanel.Dock="Top" Padding="12" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <DockPanel>
                    <local:SignalBars DockPanel.Dock="Left" Signal="{Binding Signal}" Scale="1.3" Margin="0,0,10,0">
                        <local:SignalBars.Style>
                            <Style TargetType="local:SignalBars">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signal}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:SignalBars.Style>
                    </local:SignalBars>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding NetworkTitle}" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NetworkProfile}" Style="{StaticResource Secondary}" Margin="10,3,0,0" />
                </DockPanel>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                            <Setter Property="Margin" Value="0,1,12,1" />
                        </Style>
                    </Grid.Resources>
                    <TextBlock Grid.Row="0" Text="Адрес" />
                    <TextBlock Grid.Row="1" Text="Шлюз" />
                    <TextBlock Grid.Row="2" Text="DNS" />
                    <TextBlock Grid.Row="3" Text="Прокси" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Address}" ToolTip="{Binding Address}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gateway}" ToolTip="{Binding Gateway}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Dns}" ToolTip="{Binding Dns}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Proxy}" ToolTip="{Binding Proxy}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Состояние не прочитано -->
        <Border DockPanel.Dock="Top" Margin="0,4,0,0" Padding="10,6,8,6" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xEA39;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,2,8,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <StackPanel>
                    <TextBlock Text="Состояние не прочитано" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Error}" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Признаки проблем и расхождение -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Problems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="local:ProblemViewModel">
                    <Border Margin="0,4,0,0" Padding="10,6,8,6" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,2,8,0"
                                       VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <Button DockPanel.Dock="Right" Content="Применить" Command="{Binding Apply}" Margin="8,0,0,0" Padding="10,3"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Apply}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" FontSize="11.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ход применения по шагам -->
        <Border DockPanel.Dock="Top" Margin="0,4,0,0" Padding="10,6,8,8" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StepsTitle}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding CloseStepsCommand}" ToolTip="Закрыть" Padding="6,4">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10" />
                    </Button>
                    <TextBlock Text="{Binding StepsTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:StepViewModel">
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" ToolTip="{Binding OutcomeText}" FontFamily="{StaticResource Icons}"
                                           FontSize="12" Margin="0,2,8,0" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Message}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Выполняется…" Style="{StaticResource Secondary}" Margin="20,2,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="Сети рядом" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,12,0,2" />

        <ListBox ItemsSource="{Binding Networks}" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- Строки Fluent-темы по умолчанию слишком высокие для списка сетей -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="10,4" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="local:NetworkRowViewModel">
                    <DockPanel Margin="0,2">
                        <local:SignalBars DockPanel.Dock="Left" Signal="{Binding Signal}" Margin="0,0,10,0" />
                        <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Icons}" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center" ToolTip="{Binding Security}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE785;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSecured}" Value="True">
                                            <Setter Property="Text" Value="&#xE72E;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- У текущей сети вместо «Подключиться» -->
                        <Button DockPanel.Dock="Right" Content="Применить профиль…" Click="OnApplyProfileClick" Margin="8,0,0,0" Padding="8,2"
                                FontSize="12" VerticalAlignment="Center"
                                Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}"
                                IsEnabled="{Binding DataContext.CanApplyProfile, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Profile}" ToolTip="{Binding Profile}" Style="{StaticResource Secondary}"
                                   MaxWidth="170" Margin="8,1,0,0" />
                        <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}">
                            <TextBlock Text="Подключено" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
