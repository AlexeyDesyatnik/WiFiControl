<Window x:Class="WiFiControl.RemoveProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Удаление профиля" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="Question" TextWrapping="Wrap" />
        <StackPanel x:Name="AffectedNetworks" Margin="0,12,0,0">
            <TextBlock Text="Затронутые сети" Margin="0,0,0,4" />
            <ListBox x:Name="NetworkList" MaxHeight="180" AutomationProperties.Name="Затронутые сети" />
        </StackPanel>
        <TextBlock x:Name="Fallback" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Удалить" Click="OnRemove" MinWidth="90" />
            <Button Content="Отмена" IsCancel="True" IsDefault="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
